#!/bin/bash

lockscreen="hyprlock"

usage() {
    echo "Usage: $(basename "$0") [-h|--help] [-l lockscreen command...]"
    echo ""
    echo "Options:"
    echo "  -h, --help        Show this help message"
    echo "  -l <command...>   Set lockscreen command (can include arguments)"
}

error() {
    echo "Error: $*" >&2
    usage >&2
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;

        -l)
            shift
            if [[ $# -eq 0 ]]; then
                error "-l requires a lockscreen command"
            fi

            lockscreen="$*"
            break
            ;;

        *)
            error "Unknown option: $1"
            ;;
    esac
done

figlet -f slant Hypr-Resurrect | lolcat
echo "Using screen locker: $lockscreen"
echo "Hyprctl outputs:"
hyprctl --instance 0 "keyword misc:allow_session_lock_restore 1"
hyprctl --instance 0 "dispatch exec $lockscreen"
echo ""
echo "Resurrected Hyprland"
