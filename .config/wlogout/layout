{
  "label" : "lock",
  "action" : "hyprlock",
  "text" : "Lock (l)",
  "keybind" : "l"
}

{
  "label" : "hibernate",
  "action" : "~/.local/bin/lamp off; hyprlock & sleep 1; systemctl hibernate",
  "text" : "Hibernate (h)",
  "keybind" : "h"
}

{
  "label" : "logout",
  "action" : "hyprshutdown -t 'Shutting down Hyprland...' -p 'uwsm stop'",
  "text" : "Logout (e)",
  "keybind" : "e"
}

{
  "label" : "shutdown",
  "action" : "hyprshutdown -t 'Shutting down...' -p 'systemctl poweroff'",
  "text" : "Shutdown (s)",
  "keybind" : "s"
}

{
  "label" : "suspend",
  "action" : "~/.local/bin/lamp off; hyprlock & sleep 1; systemctl suspend",
  "text" : "Suspend (u)",
  "keybind" : "u"
}

{
  "label" : "reboot",
  "action" : "hyprshutdown -t 'Rebooting...' -p 'systemctl reboot'",
  "text" : "Reboot (r)",
  "keybind" : "r"
}
